rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // In dieser Zeile die echte Admin-UID eintragen (wie in firebase-config.js).
    function isAdmin() {
      return request.auth != null && request.auth.uid == 'RSyNpHZL6icGzo8cOdgXi8mHWBi2';
    }
    function isPlayer(id) {
      return request.auth != null &&
        get(/databases/$(database)/documents/players/$(id)).data.authUid == request.auth.uid;
    }
    function isMatchParticipant() {
      let ids = resource.data.playerIds;
      return ids is list && ids.size() == 4 &&
        (isPlayer(ids[0]) || isPlayer(ids[1]) || isPlayer(ids[2]) || isPlayer(ids[3]));
    }
    function isFriendly() { return resource.data.tournamentId == ''; }
    function tournamentData() {
      return get(/databases/$(database)/documents/tournaments/$(resource.data.tournamentId)).data;
    }
    function selfScheduleEnabled() {
      return isFriendly() ? resource.data.selfSchedule == true : tournamentData().selfSchedule == true;
    }
    function selfScoreEnabled() {
      return isFriendly() ? resource.data.selfScore == true : tournamentData().selfScore == true;
    }
    function scoreFormat() {
      return isFriendly() ? resource.data.format : tournamentData().format;
    }
    function maySchedule() {
      return request.auth != null &&
        resource.data.status == 'pending' && selfScheduleEnabled() && isMatchParticipant() &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['scheduledAt', 'court']) &&
        request.resource.data.scheduledAt is string &&
        request.resource.data.scheduledAt.size() <= 24 &&
        request.resource.data.court is string &&
        request.resource.data.court.size() <= 40;
    }
    // Satzregeln: Ziel-Games + zwei Games Abstand, bei Ziel:Ziel ein
    // entscheidender Golden Point (z.B. 7:6 bei Ziel 6).
    function validSet(s, target) {
      return s is map && s.a is int && s.b is int && s.a >= 0 && s.b >= 0 &&
        ((s.a == target && s.b <= target-2) ||
         (s.b == target && s.a <= target-2) ||
         (s.a == target+1 && (s.b == target-1 || s.b == target)) ||
         (s.b == target+1 && (s.a == target-1 || s.a == target)));
    }
    function validSetAt(x, i, target) {
      return x.size() <= i || validSet(x[i], target);
    }
    function setScoreAt(x, i, side) {
      return x.size() <= i ? 0 : (side == 'A' ? x[i].a : x[i].b);
    }
    function setWinAAt(x, i) {
      return x.size() <= i ? 0 : (x[i].a > x[i].b ? 1 : 0);
    }
    function winCountA(x) {
      return setWinAAt(x,0)+setWinAAt(x,1)+setWinAAt(x,2)+setWinAAt(x,3)+setWinAAt(x,4);
    }
    function setTotal(x, side) {
      return setScoreAt(x,0,side)+setScoreAt(x,1,side)+setScoreAt(x,2,side)+
             setScoreAt(x,3,side)+setScoreAt(x,4,side);
    }
    function validSets(d, bestOf, gamesTo) {
      let x = d.sets;
      let need = bestOf == 1 ? 1 : (bestOf == 3 ? 2 : 3);
      let wonA = winCountA(x);
      let wonB = x.size() - wonA;
      return x is list && bestOf in [1,3,5] && gamesTo >= 2 && gamesTo <= 20 &&
        x.size() >= need && x.size() <= bestOf &&
        validSetAt(x,0,gamesTo) && validSetAt(x,1,gamesTo) &&
        validSetAt(x,2,gamesTo) && validSetAt(x,3,gamesTo) && validSetAt(x,4,gamesTo) &&
        d.scoreA == setTotal(x,'A') && d.scoreB == setTotal(x,'B') &&
        ((wonA == need && wonB < need && d.winner == 'A') ||
         (wonB == need && wonA < need && d.winner == 'B')) &&
        // Last set must be the first time either team reaches the target.
        wonA - setWinAAt(x,x.size()-1) < need &&
        wonB - (1-setWinAAt(x,x.size()-1)) < need;
    }
    function validBalls(d, n) {
      return d.sets is list && d.sets.size() == 0 && n >= 1 && n <= 99 &&
        ((d.scoreA + d.scoreB == n) ||
         (d.scoreA + d.scoreB == n + 1 &&
          ((d.scoreA == d.scoreB + 1) || (d.scoreB == d.scoreA + 1)))) &&
        d.winner == (d.scoreA > d.scoreB ? 'A' : (d.scoreB > d.scoreA ? 'B' : null)) &&
        (d.scoreA != d.scoreB ||
          !(resource.data.phase in ['semis', 'placement', 'final']));
    }
    function validScoring(s) {
      return s is map &&
        s.keys().hasAll(['kind','balls','bestOf','gamesTo']) &&
        s.keys().hasOnly(['kind','balls','bestOf','gamesTo']) &&
        s.kind in ['balls','sets'] && s.balls is int && s.balls >= 1 && s.balls <= 99 &&
        s.bestOf in [1,3,5] && s.gamesTo is int && s.gamesTo >= 2 && s.gamesTo <= 20;
    }
    function validScore() {
      let d = request.resource.data;
      return d.status == 'done' && d.scoreA is int && d.scoreB is int &&
        d.scoreA >= 0 && d.scoreB >= 0 && d.scoreA <= 105 && d.scoreB <= 105 &&
        d.winner in ['A', 'B', null] &&
        (resource.data.keys().hasAny(['scoring']) ?
          (validScoring(resource.data.scoring) &&
            (resource.data.scoring.kind == 'sets' ?
              validSets(d,resource.data.scoring.bestOf,resource.data.scoring.gamesTo) :
              validBalls(d,resource.data.scoring.balls))) :
          (scoreFormat() == 'sets' ? validSets(d,3,6) :
            (scoreFormat() == 'sets1' ? validSets(d,1,6) :
              (scoreFormat() == 'eight' ? validBalls(d,8) : validBalls(d,24)))));
    }
    function mayReportScore() {
      return request.auth != null && resource.data.status == 'pending' &&
        selfScoreEnabled() && isMatchParticipant() &&
        request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['status', 'scoreA', 'scoreB', 'sets', 'winner']) &&
        validScore();
    }
    function playerCreatesFriendly() {
      let d = request.resource.data;
      return request.auth != null &&
        d.keys().hasAll(['tournamentId','sideA','sideB','playerIds','format',
          'label','phase','round','order','status','scoreA','scoreB','sets',
          'winner','scheduledAt','court','selfSchedule','selfScore',
          'createdByUid','createdByPlayerId','source']) &&
        d.keys().hasOnly(['tournamentId','sideA','sideB','playerIds','format',
          'label','phase','round','order','status','scoreA','scoreB','sets',
          'winner','scheduledAt','court','selfSchedule','selfScore',
          'createdByUid','createdByPlayerId','source']) &&
        d.tournamentId == '' && d.phase == 'friendly' && d.round == 1 && d.order == 0 &&
        d.status == 'pending' && d.scoreA == null && d.scoreB == null &&
        d.winner == null && d.sets is list && d.sets.size() == 0 &&
        d.format in ['sets1','sets','eight','twentyfour'] &&
        d.selfSchedule == true && d.selfScore == true &&
        d.source == 'player' && d.createdByUid == request.auth.uid &&
        d.label is string && d.label.size() > 0 && d.label.size() <= 90 &&
        d.scheduledAt is string && d.scheduledAt.size() <= 24 &&
        d.court is string && d.court.size() <= 40 &&
        (d.scheduledAt == '' || d.court.size() > 0) &&
        d.sideA is list && d.sideA.size() == 2 &&
        d.sideB is list && d.sideB.size() == 2 &&
        d.playerIds is list && d.playerIds.size() == 4 &&
        d.playerIds == [d.sideA[0],d.sideA[1],d.sideB[0],d.sideB[1]] &&
        d.sideA[0] != d.sideA[1] && d.sideA[0] != d.sideB[0] &&
        d.sideA[0] != d.sideB[1] && d.sideA[1] != d.sideB[0] &&
        d.sideA[1] != d.sideB[1] && d.sideB[0] != d.sideB[1] &&
        d.createdByPlayerId == d.sideA[0] && isPlayer(d.createdByPlayerId) &&
        exists(/databases/$(database)/documents/players/$(d.sideA[1])) &&
        exists(/databases/$(database)/documents/players/$(d.sideB[0])) &&
        exists(/databases/$(database)/documents/players/$(d.sideB[1]));
    }
    match /players/{id} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }
    match /tournaments/{id} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }
    match /matches/{id} {
      allow read: if true;
      allow create: if isAdmin() || playerCreatesFriendly();
      allow delete: if isAdmin();
      allow update: if isAdmin() || maySchedule() || mayReportScore();
    }
    match /claims/{uid} {
      allow read: if isAdmin() || (request.auth != null && request.auth.uid == uid);
      allow create: if request.auth != null && request.auth.uid == uid &&
        request.resource.data.keys().hasOnly(['playerId','requestedAt','approved']) &&
        request.resource.data.keys().hasAll(['playerId','requestedAt','approved']) &&
        request.resource.data.approved == false &&
        request.resource.data.playerId is string &&
        exists(/databases/$(database)/documents/players/$(request.resource.data.playerId));
      allow update, delete: if isAdmin();
    }
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
